{
  "dataset": {
    "name": "Breast Cancer Wisconsin (Diagnostic)",
    "local_csv_path": "data/breast_cancer_wisconsin.csv",
    "test_size": 0.2,
    "random_state": 42
  },
  "training": {
    "cv_folds": 5,
    "random_state": 42,
    "selection_metric": "roc_auc",
    "threshold_strategy": "f2_oof",
    "model_output_path": "models/disease_prediction_bundle.joblib"
  },
  "evaluation": {
    "report_path": "reports/model_evaluation.md",
    "metrics_json_path": "reports/metrics.json",
    "figures_dir": "reports/figures"
  }
}
